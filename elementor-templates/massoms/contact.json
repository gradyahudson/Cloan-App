            {
              "id": "macw10",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<p style=\"color:#6b7280;font-size:.9rem;margin-bottom:24px;\">Install <strong>WPForms Lite</strong> or <strong>Contact Form 7</strong>, create a contact form, then replace this placeholder with the shortcode.</p>\n<div style=\"border:2px dashed #e5e7eb;border-radius:6px;padding:48px;text-align:center;background:#f9fafb;\">\n  <p style=\"color:#6b7280;font-size:.95rem;\">📋 <strong>Contact Form Placeholder</strong><br>Replace with: <code>[wpforms id=\"1\"]</code><br>or: <code>[contact-form-7 id=\"1\"]</code></p>\n</div>"
              },
              "elements": []
            }
          ]

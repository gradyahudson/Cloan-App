            {
              "id": "macw08",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "editor": "<p style=\"color:#6b7280;font-size:.9rem;\">To find an OMS in Massachusetts, please use our <a href=\"/find-a-surgeon/\" style=\"color:#1a4080;font-weight:600;\">surgeon directory</a>. MassOMS is a professional society and does not provide direct patient services.</p>"

                "html": "<div style=\"display:flex;gap:12px;flex-wrap:wrap;padding:24px;background:#f9fafb;border:1px solid #e5e7eb;border-radius:6px;margin-bottom:12px;\">\n  <input type=\"text\" placeholder=\"Search by name or city...\" style=\"flex:1;min-width:200px;padding:10px 14px;border:1px solid #e5e7eb;border-radius:6px;font-size:.95rem;\">\n  <select style=\"padding:10px 14px;border:1px solid #e5e7eb;border-radius:6px;font-size:.95rem;min-width:180px;\">\n    <option value=\"\">All Regions</option>\n    <option>Boston / Greater Boston</option>\n    <option>Worcester</option>\n    <option>Springfield / Western Mass</option>\n    <option>North Shore</option>\n    <option>South Shore / Cape Cod</option>\n    <option>Pioneer Valley</option>\n  </select>\n  <select style=\"padding:10px 14px;border:1px solid #e5e7eb;border-radius:6px;font-size:.95rem;min-width:180px;\">\n    <option value=\"\">All Specialties</option>\n    <option>Dental Implants</option>\n    <option>Wisdom Teeth</option>\n    <option>Jaw Surgery</option>\n    <option>TMJ Treatment</option>\n    <option>Facial Trauma</option>\n    <option>Reconstructive Surgery</option>\n  </select>\n  <button style=\"padding:10px 24px;background:#1a4080;color:#fff;border:none;border-radius:6px;font-size:.95rem;font-weight:600;cursor:pointer;\">Search</button>\n</div>\n<p style=\"color:#6b7280;font-size:.85rem;\">Install <em>Business Directory Plugin</em> or a custom Surgeons post type for live search. This form is a layout placeholder.</p>"
